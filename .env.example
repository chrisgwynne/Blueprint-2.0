# ─── Blueprint Environment Configuration ─────────────────────────────────────
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# ─── Server ──────────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development

# ─── Database ────────────────────────────────────────────────────────────────
# Use an absolute path in development to avoid CWD ambiguity.
# In Docker this is set to /app/data/blueprint.db via docker-compose.yml.
DATABASE_PATH=./data/blueprint.db

# ─── Paths ───────────────────────────────────────────────────────────────────
KB_PATH=./kb
AGENTS_PATH=./agents

# ─── Security ────────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=replace-with-64-char-hex-string-generated-by-openssl-rand-hex-32
SESSION_SECRET=replace-with-another-64-char-hex-string-for-session-signing

# ─── Auth (single user) ──────────────────────────────────────────────────────
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme

# ─── LLM ─────────────────────────────────────────────────────────────────────
# Required for agent runs. Get yours at https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-your-key-here

# ─── Google OAuth (GA4 + GSC connectors) ─────────────────────────────────────
# Create at https://console.cloud.google.com → APIs & Services → Credentials
# Enable: Google Search Console API, Google Analytics Data API
# OAuth redirect URI must match GOOGLE_REDIRECT_URI exactly.
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your-client-secret
GOOGLE_REDIRECT_URI=http://localhost:4000/api/auth/google/callback

# ─── Telegram (optional) ─────────────────────────────────────────────────────
# Get bot token from @BotFather. Get chat ID from https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Optional: secure your webhook endpoint
TELEGRAM_WEBHOOK_SECRET=

# ─── PageSpeed (optional) ────────────────────────────────────────────────────
# Works without a key (lower rate limits). Get free key at https://developers.google.com/speed/docs/insights/v5/get-started
PAGESPEED_API_KEY=
