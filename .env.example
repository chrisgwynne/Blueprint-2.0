# ─── Blueprint Environment Configuration ─────────────────────────────────────
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# ─── Server ──────────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development

# ─── Database ────────────────────────────────────────────────────────────────
# Use an absolute path in development to avoid CWD ambiguity.
# In Docker this is set to /app/data/blueprint.db via docker-compose.yml.
DATABASE_PATH=./data/blueprint.db

# ─── Paths ───────────────────────────────────────────────────────────────────
KB_PATH=./kb

# ─── Security ────────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=replace-with-64-char-hex-string-generated-by-openssl-rand-hex-32
SESSION_SECRET=replace-with-another-64-char-hex-string-for-session-signing

# ─── Auth (single user) ──────────────────────────────────────────────────────
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme

# ─── LLM Providers ───────────────────────────────────────────────────────────
# Configure at least one. Ollama requires no API key.
# You can configure multiple and assign different providers to different agents
# via Settings → LLM Providers.

# Ollama — local, free, no API key needed
# Install: https://ollama.ai  then: ollama pull llama3
OLLAMA_BASE_URL=http://localhost:11434

# Anthropic Claude (optional)
# Get key: https://console.anthropic.com
# ANTHROPIC_API_KEY=sk-ant-...

# OpenAI (optional)
# Get key: https://platform.openai.com/api-keys
# OPENAI_API_KEY=sk-proj-...

# Google Gemini (optional)
# Get key: https://aistudio.google.com/app/apikey
# GOOGLE_GEMINI_API_KEY=...

# ─── Google OAuth (GA4 + GSC connectors) ─────────────────────────────────────
# Create at https://console.cloud.google.com → APIs & Services → Credentials
# Enable: Google Search Console API, Google Analytics Data API
# OAuth redirect URI must match GOOGLE_REDIRECT_URI exactly.
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your-client-secret
GOOGLE_REDIRECT_URI=http://localhost:4000/api/auth/google/callback

# ─── Telegram (optional) ─────────────────────────────────────────────────────
# Get bot token from @BotFather. Get chat ID from https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Optional: secure your webhook endpoint
TELEGRAM_WEBHOOK_SECRET=

# ─── PageSpeed (optional) ────────────────────────────────────────────────────
# Works without a key (lower rate limits). Get free key at https://developers.google.com/speed/docs/insights/v5/get-started
PAGESPEED_API_KEY=

# ─── Todoist OAuth (optional) ────────────────────────────────────────────────
# Create an app at https://developer.todoist.com/appconsole.html
TODOIST_CLIENT_ID=
TODOIST_CLIENT_SECRET=
TODOIST_REDIRECT_URI=http://localhost:4000/api/oauth/todoist/callback

# ─── Google Ads (optional) ───────────────────────────────────────────────────
# Reuses GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET above with the adwords scope.
# Developer token: apply at https://ads.google.com/home/tools/manager-accounts/
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_REDIRECT_URI=http://localhost:4000/api/oauth/google-ads/callback

# ─── Meta Ads (Facebook + Instagram) (optional) ─────────────────────────────
# Create at https://developers.facebook.com → My Apps → Create App
#   App type: Business
#   Add product: Marketing API
#   Permissions: ads_read, read_insights, business_management
#   Add redirect URI: http://localhost:4000/api/oauth/meta/callback
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=http://localhost:4000/api/oauth/meta/callback

# ─── Frontend URL (used for OAuth redirects back to UI) ──────────────────────
CLIENT_URL=http://localhost:5173

# ─── Advanced (optional) ────────────────────────────────────────────────────

# CORS — allowed origins for API requests (comma-separated).
# Default: auto-detected from CLIENT_URL and PORT.
# CORS_ORIGINS=https://yourdomain.com,http://localhost:5173

# Scheduler — set to 'true' to disable all cron jobs (useful for testing).
# DISABLE_SCHEDULER=false

# Google Business Profile OAuth redirect URI.
# Only set if different from GOOGLE_REDIRECT_URI.
# GBP_REDIRECT_URI=http://localhost:4000/api/oauth/gbp/callback

# Project root path override (auto-detected normally).
# Only set if Blueprint is running from a non-standard directory.
# PROJECT_ROOT=/app
