{
  "name": "blueprint",
  "version": "0.9.0-beta",
  "description": "A personal business operating system — connect data sources, detect signals, let AI agents take action.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "workspaces": ["server", "client"],
  "scripts": {
    "setup": "bun scripts/setup.js",
    "dev": "bun scripts/dev.js",
    "build": "bun run --cwd client build",
    "start": "bun run --cwd server start",
    "db:init": "bun run --cwd server db:init",
    "typecheck": "bun run --cwd server typecheck && bun run --cwd client typecheck",
    "build:sidecar": "bun scripts/build-sidecar.js",
    "tauri": "bun run --cwd client tauri",
    "tauri:dev": "bun run --cwd client tauri dev",
    "tauri:build": "bun run --cwd client tauri build"
  },
  "devDependencies": {
    "typescript": "^6.0.2"
  }
}
