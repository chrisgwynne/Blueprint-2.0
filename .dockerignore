# Keeps the build context small and avoids leaking local/dev-only state
# into image layers. Mirrors .gitignore, plus repo metadata Docker never
# needs.

.git/
.github/
.claude/

node_modules/
server/node_modules/
client/node_modules/

dist/
build/
.vite/
client/dist/

.env
.env.local
.env.*.local

data/
server/data/
kb/
server/kb/

server/agents/*/memory.json
server/agents/*/run-log.jsonl
server/agents/*/inbox.jsonl

*.log
logs/
npm-debug.log*
coverage/
.nyc_output/
tmp/
temp/
.cache/

.DS_Store
.vscode/
.idea/

README.md
CHANGELOG.md
CONTRIBUTING.md
*.md
docs/
