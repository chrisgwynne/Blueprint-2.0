# Dependencies
node_modules/
.pnp
.pnp.js

# Build output
dist/
build/
.vite/

# Environment — NEVER commit these
.env
.env.local
.env.*.local

# Database — user data stays local
data/blueprint.db
data/blueprint.db-shm
data/blueprint.db-wal
data/*.db
# Stray runtime DB if a process is launched from server/ with the default
# relative './data/blueprint.db' path (server/index.js fallback).
server/data/

# Knowledge base — user content stays local
/kb/
server/kb/

# Agent runtime files — user-specific
server/agents/*/memory.json
server/agents/*/run-log.jsonl
server/agents/*/inbox.jsonl

# OS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
Desktop.ini

# Editor
.vscode/settings.json
.idea/
*.swp
*.swo
*~

# Logs
*.log
logs/
npm-debug.log*

# Docker
.docker/

# Temporary
tmp/
temp/
.cache/

# Test artifacts
coverage/
.nyc_output/

# Claude Code isolated worktrees (harness artifact)
.claude/

# Stray SQLite artifacts (e.g. a literal ":memory:" file from a test run)
:memory:*
