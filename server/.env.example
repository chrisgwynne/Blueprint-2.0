# Blueprint Server — Environment Variables
# Copy this file to .env and fill in your values.

# ─── Server ──────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000

# ─── Auth ────────────────────────────────────────────────────────────────────
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme

# Session secret — generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=your-secret-here

# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_PATH=./data/blueprint.db

# ─── Encryption ──────────────────────────────────────────────────────────────
# 32-byte hex key — generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=your-64-char-hex-key-here

# ─── Anthropic ───────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ─── Google OAuth (for GSC + GA4 connectors) ─────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/oauth/google/callback

# ─── PageSpeed ───────────────────────────────────────────────────────────────
# Free key: console.cloud.google.com → Enable "PageSpeed Insights API" → Create API Key
PAGESPEED_API_KEY=

# ─── Telegram ────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Optional: set this to validate webhook requests from Telegram
TELEGRAM_WEBHOOK_SECRET=

# ─── Knowledge Base ──────────────────────────────────────────────────────────
KB_PATH=../kb

# ─── CORS ────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173,http://localhost:4000

# ─── Scheduler ───────────────────────────────────────────────────────────────
DISABLE_SCHEDULER=false
